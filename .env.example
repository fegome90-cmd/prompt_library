# Copy to .env or .env.local; never commit actual secrets.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Self-registration is closed unless explicitly enabled.
ENABLE_PUBLIC_SIGNUP="false"

# Local CLI seeding (scripts/seed.ts), not exposed by HTTP.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Only set true for an intentional one-time production seed.
ALLOW_PRODUCTION_SEED="false"

# Unsafe development-only bypass; leave disabled in shared environments.
DEV_AUTH_BYPASS="false"
